# tablica-php – zabezpieczenia dla serwera Apache
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 32M
</IfModule>
